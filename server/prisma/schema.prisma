// Prisma schema for TrialMatch Complete Platform (Supabase PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id                 String                @id @default(uuid())
  full_name          String
  age                Int
  gender             String                // MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY
  location           String
  created_at         DateTime              @default(now())
  documents          Document[]
  documentAssessment DocumentAssessment?
  questionnaires     PatientQuestionnaire[]
  discrepancyFlags   DiscrepancyFlag[]
  matchResults       PatientMatchResult[]
}

model Document {
  id                 String   @id @default(uuid())
  patient_id         String
  patient            Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  file_name          String
  file_url           String
  file_type          String
  file_size          Int
  upload_status      String   @default("PENDING") // PENDING, COMPLETED, FAILED
  ocr_extracted_text String?  @db.Text
  extracted_summary  String?  @db.Text
  created_at         DateTime @default(now())
}

model DocumentAssessment {
  id                  String   @id @default(uuid())
  patient_id          String   @unique
  patient             Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  suspected_condition String?
  disease_stage       String?
  diagnosis_date      String?
  medications_listed  String   @db.Text // JSON string array
  key_lab_values      String   @db.Text // JSON object string or serialized text
  raw_summary         String   @db.Text
  created_at          DateTime @default(now())
}

model PatientQuestionnaire {
  id               String    @id @default(uuid())
  patient_id       String
  patient          Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  questions        String    @db.Text // JSON string array of generated questions
  verbatim_answers String?   @db.Text // JSON object mapping question -> answer
  is_completed     Boolean   @default(false)
  created_at       DateTime  @default(now())
  completed_at     DateTime?
}

model DiscrepancyFlag {
  id                String   @id @default(uuid())
  patient_id        String
  patient           Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  severity_level    String   // "LOW", "MEDIUM", "HIGH"
  conflict_topic    String   // e.g., "Primary Diagnosis", "Medication Mismatch", "Symptom Severity"
  document_evidence String   @db.Text
  patient_claim     String   @db.Text
  created_at        DateTime @default(now())
}

model ClinicalTrial {
  id                 String               @id @default(uuid())
  trial_code         String               @unique // e.g., "NCT05123456"
  title              String
  disease_category   String               // e.g., "Type 2 Diabetes", "Oncology", "Cardiology", "Asthma"
  phase              String               // e.g., "Phase II", "Phase III"
  min_age            Int
  max_age            Int
  gender_requirement String               // "ALL", "MALE", "FEMALE"
  location           String
  inclusion_criteria String               @db.Text // JSON string array of inclusion statements
  exclusion_criteria String               @db.Text // JSON string array of exclusion statements
  status             String               @default("RECRUITING")
  created_at         DateTime             @default(now())
  match_results      PatientMatchResult[]
}

model PatientMatchResult {
  id                    String        @id @default(uuid())
  patient_id            String
  patient               Patient       @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  trial_id              String
  trial                 ClinicalTrial @relation(fields: [trial_id], references: [id], onDelete: Cascade)
  eligibility_category  String        // "ELIGIBLE" or "LESS_ELIGIBLE"
  rank_score            Int           // 1 to 100 ranking score
  criterion_explanation String        @db.Text // Detailed criterion-by-criterion explanation
  created_at            DateTime      @default(now())
  doctorReview          DoctorReview?
}

model DoctorReview {
  id              String             @id @default(uuid())
  match_result_id String             @unique
  match_result    PatientMatchResult @relation(fields: [match_result_id], references: [id], onDelete: Cascade)
  doctor_decision String             // "APPROVED", "REJECTED", "MORE_INFO_NEEDED"
  doctor_notes    String?            @db.Text
  reviewed_at     DateTime           @default(now())
}
